# Dataset files (重要！)
# Note: `dataset/*` rather than `dataset/`, because git will not descend into
# an excluded directory, and so cannot re-include the scripts below it.
dataset/*
data/

# ...these are source code, not data. The bare `data/` rule also matches
# svgnet/data/, which is why that package was absent from the published
# release; `dataset/` likewise hid the preprocessing scripts.
!svgnet/data/
!svgnet/data/**
!dataset/*.py

# ...but the un-ignore above must not drag compiled bytecode back in.
svgnet/data/__pycache__/
**/__pycache__/
*.pyc
*.zip
